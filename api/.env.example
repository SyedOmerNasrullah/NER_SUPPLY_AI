# NER-SupplyAI API — copy to .env and fill in. NEVER commit .env.
#
# Phase 4A configures DATABASE_URL only. Every other key below belongs to a later
# phase and is listed so the shape of the final configuration is visible, not so it
# gets filled in now. Naming follows the original backend's .env.example exactly, so
# there is one DATABASE_URL in this project and not two competing spellings.

# --- Phase 4A -------------------------------------------------------------
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require"
PORT=4000
NODE_ENV=development

# Signing key for session tokens. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every issued token, which is the intended behaviour.
JWT_SECRET=

# Password given to the seeded demonstration accounts. Optional; defaults to the demo
# adapter's published password. These accounts exist only on a seeded demo database.
DEMO_ACCOUNT_PASSWORD=
# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Later phases — configured but NOT USED until Phase 5+ ----------------
# --- Phase 5A / 6B — the internal ML service -------------------------------
# "demo" = Express never calls FastAPI; "live" = it may. An unrecognised value stops the server.
ML_MODE=demo
ML_SERVICE_URL=http://localhost:8000
# Shared secret between Express and FastAPI. Required only when ML_MODE=live. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ML_INTERNAL_TOKEN=
# --- Phase 6C — Gemini (explanation + incident vision) ---------------------
# Optional. Without a key every explanation comes from the deterministic template and incident
# photographs are simply not classified; nothing else changes.
GEMINI_API_KEY=
# Defaults to gemini-3.1-flash-lite. Override if the account has something better.
GEMINI_MODEL=
GEMINI_VISION_MODEL=
ORS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
