# Frontend configuration. Copy to .env. No secrets belong here — anything in a Vite
# `VITE_` variable is compiled into the bundle and readable by anyone with the page open.
# Database credentials and API keys live in api/.env, server-side only.

# Which DataSource answers: `demo` (deterministic fixtures) or `http` (the Node API).
VITE_DATA_SOURCE=demo
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# The segment the Command Center's simulate control targets — SEG-010, Bhalukpong–Tenga Valley.
VITE_DEMO_SEGMENT_ID=d0000000-0000-4000-8000-000000000010
